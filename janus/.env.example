# Copy to .env and fill in. NEVER commit .env.
# All vars are validated by janus.config.settings; missing required vars fail-fast at startup.

# ───── Runtime ─────
JANUS_ENV=dev                       # dev | paper | live
JANUS_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
JANUS_LOG_JSON=true                 # JSON logs for prod, plain for local
JANUS_RANDOM_SEED=42                # reproducibility — fixed across processes

# ───── TimescaleDB ─────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=janus
POSTGRES_USER=janus
POSTGRES_PASSWORD=janus_dev

# ───── Redis ─────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ───── Exchange API (read-only keys for Phase 0) ─────
# Phase 0 uses public endpoints only. Provide keys to lift rate limits.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ───── Data providers (Phase 0 stubs) ─────
COINGLASS_API_KEY=
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=

# ───── Observability ─────
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PROMETHEUS_PORT=9090

# ───── Tests ─────
JANUS_ENABLE_LIVE_TESTS=0           # set to 1 to run tests that hit real APIs

# ───── SaaS API ─────
# On Railway these come from the Postgres + Redis service links automatically.
# Locally, the POSTGRES_* / REDIS_* values above take precedence.
# DATABASE_URL=postgresql://janus:janus_dev@localhost:5432/janus
# REDIS_URL=redis://localhost:6379/0

JANUS_API_API_KEY_PEPPER=replace-me-with-32-chars-of-randomness
JANUS_API_CORS_ALLOW_ORIGINS=*
JANUS_API_RATE_LIMIT_PER_MINUTE=120
# PORT is provided by Railway; only set locally if you need to override.
# PORT=8000
